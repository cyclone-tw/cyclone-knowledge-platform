<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cyclone.ckp-gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "__REPO_DIR__" &amp;&amp; set -a &amp;&amp; source "$HOME/.config/cyclone/ckp-gateway.env" &amp;&amp; set +a &amp;&amp; exec "__REPO_DIR__/.venv/bin/python" -m ckp</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/gateway.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/gateway.err.log</string>
</dict>
</plist>
